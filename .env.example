# === Telegram Bot ===
BOT_TOKEN=your-telegram-bot-token-here
# Optional proxy for Telegram Bot API calls and file downloads.
# Use only infrastructure you control and are allowed to use.
TELEGRAM_API_PROXY_URL=

# === Backend Connection ===
BACKEND_BASE_URL=http://localhost:8000

# === Mini App URL ===
# Used for menu button and deep links.
# For local dev with ngrok: https://<id>.ngrok-free.app/mini_app/
MINI_APP_URL=https://example.com/mini_app/

# === Application ===
DEBUG=false
# true = structlog PII/secret redaction; false = raw event fields
REDACT_LOGS=true
# With REDACT_LOGS=true: false keeps telegram_id, user_id, file_id, client_ip
# visible; tokens still fully redacted.
REDACT_LOG_IDENTIFIERS=true

# === Redis (for file_id cache, player sessions) ===
REDIS_URL=redis://localhost:6379/0

# === Internal API (for backend communication) ===
INTERNAL_API_PORT=8081
# Dev / bare metal: loopback only. Compose задаёт INTERNAL_API_COMPOSE_BIND
# и INTERNAL_API_HOST=0.0.0.0 (порт 8081 не публикуйте на хост).
INTERNAL_API_HOST=127.0.0.1
INTERNAL_API_SECRET=replace-with-local-shared-secret

# === Admin Panel Alerts ===
# Comma-separated chat_id allowlist for /internal/admin-alert.
# Backend must pass one of these chat_ids; anything else returns 403.
# Empty value = allow any chat_id (use only in dev).
ADMIN_ALERT_CHAT_ID_ALLOWLIST=
# Chat id where backup job notifications should be delivered.
BACKUP_NOTIFY_TELEGRAM_ID=0

# === Logging ===
LOG_LEVEL=INFO
# stdlib: aiogram, httpx, httpcore, aiohttp. DEBUG = HTTP traces.
LOG_THIRD_PARTY_LEVEL=WARNING

# === Throttling ===
# Generic per-user event throttle (messages/inline by default).
THROTTLE_RATE_LIMIT=0.7
# Dedicated per-user callback throttle for inline buttons/player controls.
THROTTLE_CALLBACK_RATE_LIMIT=0.35
