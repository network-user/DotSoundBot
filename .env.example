# === Telegram Bot ===
BOT_TOKEN=your-telegram-bot-token-here

# === Backend Connection ===
BACKEND_BASE_URL=http://localhost:8000

# === Mini App URL ===
# Used for menu button and deep links.
# For local dev with ngrok: https://<id>.ngrok-free.app/mini_app/
MINI_APP_URL=https://t.me/dotsoundbot/app

# === Application ===
DEBUG=true
# true = mask telegram_id, user_id, file_id etc. in logs; false = show raw values
REDACT_LOGS=true

# === Redis (for file_id cache, player sessions) ===
REDIS_URL=redis://localhost:6379/0

# === Internal API (for backend communication) ===
INTERNAL_API_PORT=8081
INTERNAL_API_SECRET=change-me-shared-secret

# === Logging ===
LOG_LEVEL=INFO
